<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name" android:textSize="28sp" android:textColor="#392619" android:textStyle="bold" android:layout_marginTop="12dp" android:layout_marginBottom="16dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:text="@string/order_heading" android:textColor="#35251F" android:textSize="18sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal" android:baselineAligned="false">
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnTea" style="@style/DrinkButton" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnCoffee" style="@style/DrinkButton" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnCappuccino" style="@style/DrinkButton" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnLatte" style="@style/DrinkButton" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/size_heading" android:textColor="#35251F" android:textSize="20sp" android:textStyle="bold" />
        <RadioGroup android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
            <RadioButton android:id="@+id/sizeSmall" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/size_small" android:textSize="12sp" android:saveEnabled="false" />
            <RadioButton android:id="@+id/sizeMedium" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/size_medium" android:textSize="12sp" android:saveEnabled="false" />
            <RadioButton android:id="@+id/sizeLarge" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/size_large" android:textSize="12sp" android:saveEnabled="false" />
        </RadioGroup>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/extras_heading" android:textColor="#35251F" android:textSize="20sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <CheckBox android:id="@+id/checkSugar" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:textSize="12sp" android:saveEnabled="false" />
            <CheckBox android:id="@+id/checkMilk" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:textSize="12sp" android:saveEnabled="false" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/pricing_note" android:textColor="#7E6B5A" android:textSize="12sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:layout_marginBottom="16dp" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/quantity_label" android:textColor="#7E6B5A" android:textSize="15sp" />
                <Button android:id="@+id/btnMinus" style="@style/StepButton" android:text="@string/minus" android:contentDescription="@string/decrease_quantity" />
                <TextView android:id="@+id/txtQuantity" android:layout_width="44dp" android:layout_height="wrap_content" android:gravity="center" android:textColor="#35251F" android:textSize="21sp" android:textStyle="bold" android:accessibilityLiveRegion="polite" android:saveEnabled="false" />
                <Button android:id="@+id/btnPlus" style="@style/StepButton" android:text="@string/plus" android:contentDescription="@string/increase_quantity" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="18dp" android:layout_marginBottom="18dp" android:background="#EFE7DD" />
            <TextView android:id="@+id/txtTotal" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#35251F" android:textSize="28sp" android:textStyle="bold" android:accessibilityLiveRegion="polite" android:saveEnabled="false" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnPlaceOrder" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="20dp" android:text="@string/place_order" android:textAllCaps="false" android:textSize="16sp" android:textStyle="bold" android:textColor="#FFFFFF" android:background="@drawable/action_background" style="@style/OrderButton" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
