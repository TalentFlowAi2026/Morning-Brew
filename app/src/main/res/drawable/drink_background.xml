<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="#493226" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="#D6A369" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#EFE1CF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#FFFFFF" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#E8DED2" />
        </shape>
    </item>
</selector>
