<resources>
    <style name="Theme.MorningBrew" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="colorAccent">#70432B</item>
        <item name="android:statusBarColor">#FAF5ED</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#392619</item>
        <item name="android:windowBackground">#FAF5ED</item>
    </style>
    <style name="DrinkButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">112dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:background">@drawable/drink_background</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/drink_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:padding">1dp</item><item name="android:drawableTop">@drawable/ic_cup</item><item name="android:drawablePadding">8dp</item><item name="android:stateListAnimator">@null</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
    </style>
<style name="StepButton" parent="Widget.AppCompat.Button">
<item name="android:layout_width">52dp</item><item name="android:layout_height">52dp</item>
<item name="android:background">@drawable/step_background</item><item name="backgroundTint">@null</item>
<item name="android:textColor">#493226</item><item name="android:textSize">24sp</item>
<item name="android:minWidth">0dp</item><item name="android:minHeight">48dp</item><item name="android:stateListAnimator">@null</item>
</style><style name="OrderButton" parent="Widget.AppCompat.Button"><item name="backgroundTint">@null</item><item name="android:stateListAnimator">@null</item></style></resources>
