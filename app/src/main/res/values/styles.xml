<resources>
    <style name="Theme.MorningBrew" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="colorAccent">#70432B</item>
        <item name="android:statusBarColor">#FAF5ED</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#FAF5ED</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">#FAF5ED</item>
    </style>
    <style name="DrinkButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">88dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:background">@drawable/drink_background</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/drink_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:padding">2dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>
